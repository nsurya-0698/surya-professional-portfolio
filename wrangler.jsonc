{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "surya-portfolio-assistant",
  "main": "workers/profile-assistant.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "VISITOR_RATE_LIMITER",
      "namespace_id": "10427",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "10428",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "WEATHER_RATE_LIMITER",
      "namespace_id": "10429",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "WEATHER_GLOBAL_RATE_LIMITER",
      "namespace_id": "10430",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
